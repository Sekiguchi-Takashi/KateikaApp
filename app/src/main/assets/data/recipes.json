{
  "recipes": [
    {
      "id": "r_gohan",
      "name": "ごはん",
      "category": "主食",
      "difficulty": 1,
      "baseServings": 2,
      "point": "水加減は米の体積の1.2倍が目安。炊く前の吸水でふっくら炊ける。",
      "ingredients": [
        {
          "name": "米",
          "amount": 150,
          "unit": "g（1合）",
          "scalable": true,
          "round": "int"
        },
        {
          "name": "水",
          "amount": 220,
          "unit": "ml",
          "scalable": true,
          "round": "int"
        }
      ],
      "steps": [
        {
          "text": "米をボウルに入れ、水を注いでさっと混ぜてすぐ捨てる。これを2〜3回くり返して洗う。",
          "time": "3分",
          "heat": "－"
        },
        {
          "text": "分量の水にひたして吸水させる。",
          "time": "30分以上",
          "heat": "－"
        },
        {
          "text": "ふたをして火にかけ、沸とうさせる。",
          "time": "約5分",
          "heat": "中火"
        },
        {
          "text": "沸とうしたら火を弱め、そのまま炊く。",
          "time": "12分",
          "heat": "弱火"
        },
        {
          "text": "火を止めてふたを開けずに蒸らす。",
          "time": "10分",
          "heat": "－"
        },
        {
          "text": "しゃもじで底から返すようにほぐす。",
          "time": "1分",
          "heat": "－"
        }
      ]
    },
    {
